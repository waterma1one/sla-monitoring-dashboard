{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "sla-worker",
	"main": "src/index.ts",
	"compatibility_date": "2026-09-22",
	"dev": {
		// Keeps worker-configuration.d.ts in sync automatically while `wrangler dev`
		// is running; `npm run types` regenerates it otherwise.
		"generate_types": true,
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "sla-monitoring",
			"database_id": "edf9c3c5-76b0-454a-9855-9ef9d2732748",
			"migrations_dir": "../migrations",
		},
	],
}
